<?xml version="1.0" encoding="utf-8"?>
<!--
    Excludes all app data from Android cloud backup (API 31+).
    Vaulted Money stores financial data locally — backing it up to Google Drive
    would violate the app's "your data stays on your device" privacy promise.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
